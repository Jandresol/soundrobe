# Soundrobe local configuration
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real API secrets.

# Demo profile options:
# demo-jasmine, demo-dream, demo-pop, demo-70s, demo-90s
SOUNDROBE_DEMO_PROFILE_ID=demo-jasmine

# Spotify Web API
# Create an app at https://developer.spotify.com/dashboard
# Local development:
# Add the exact redirect URI below to the Spotify app settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/music/spotify/callback
SOUNDROBE_APP_URL=http://127.0.0.1:3000

# Production on Vercel:
# SPOTIFY_REDIRECT_URI=https://your-domain.vercel.app/api/music/spotify/callback
# SOUNDROBE_APP_URL=https://your-domain.vercel.app

# Commerce provider
# Current code falls back to DemoCommerceProvider.
# Use "serpapi" only when you are ready to spend search quota.
COMMERCE_PROVIDER=demo

# SerpApi Google Shopping
# Get this from https://serpapi.com/
SERPAPI_API_KEY=
SERPAPI_MAX_LIVE_SEARCHES_PER_GENERATION=3
SERPAPI_RESULTS_PER_SEARCH=20
PRODUCT_CACHE_TTL_DAYS=30

# Optional generic commerce key for a future provider adapter.
COMMERCE_API_KEY=

# Last.fm genre/tag enrichment
# Create an API account at https://www.last.fm/api/account/create
# Used when Spotify artist.genre data is sparse or unavailable.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_GENRE_ENRICHMENT_ENABLED=false
